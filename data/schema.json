{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Awesome Developer Streams Schema",
  "description": "JSON schema for developer streamer data",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the data was updated"
    },
    "statistics": {
      "$ref": "#/definitions/statistics"
    },
    "streamers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/streamer"
      }
    }
  },
  "required": ["version", "lastUpdated", "statistics", "streamers"],
  "definitions": {
    "statistics": {
      "type": "object",
      "properties": {
        "totalStreamers": {
          "type": "integer",
          "description": "Total number of streamers"
        },
        "totalTopics": {
          "type": "integer",
          "description": "Total number of unique topics/technologies"
        },
        "totalPlatforms": {
          "type": "integer",
          "description": "Total number of unique platforms"
        },
        "totalLanguages": {
          "type": "integer",
          "description": "Total number of unique spoken languages"
        },
        "platformBreakdown": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Count of streamers per platform"
        },
        "languageBreakdown": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Count of streamers per language"
        },
        "topTopics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic": {
                "type": "string"
              },
              "count": {
                "type": "integer"
              }
            }
          },
          "description": "Most popular topics with counts"
        }
      },
      "required": ["totalStreamers", "totalTopics", "totalPlatforms", "totalLanguages", "platformBreakdown", "languageBreakdown", "topTopics"]
    },
    "streamer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (slug format)"
        },
        "name": {
          "type": "string",
          "description": "Full name or primary name"
        },
        "aka": {
          "type": "string",
          "description": "Also known as / stream name / channel name (if different from name)"
        },
        "handle": {
          "type": "string",
          "description": "Preferred handle or username"
        },
        "description": {
          "type": "string",
          "description": "What they stream"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Technologies, languages, and topics they stream about"
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/platform"
          },
          "description": "Streaming platforms"
        },
        "links": {
          "type": "object",
          "properties": {
            "twitter": {"type": "string", "format": "uri"},
            "github": {"type": "string", "format": "uri"},
            "website": {"type": "string", "format": "uri"},
            "youtube": {"type": "string", "format": "uri"},
            "discord": {"type": "string", "format": "uri"},
            "patreon": {"type": "string", "format": "uri"},
            "instagram": {"type": "string", "format": "uri"},
            "linkedin": {"type": "string", "format": "uri"},
            "facebook": {"type": "string", "format": "uri"},
            "blog": {"type": "string", "format": "uri"},
            "medium": {"type": "string", "format": "uri"}
          },
          "description": "Social media and other links"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Spoken languages during stream"
        },
        "alphabeticalSection": {
          "type": "string",
          "pattern": "^[A-Z#]$",
          "description": "Alphabetical section (A-Z or # for numbers)"
        }
      },
      "required": ["id", "name", "topics", "platforms", "alphabeticalSection"]
    },
    "platform": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Platform name (e.g., Twitch, YouTube)"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL to the stream/channel"
        }
      },
      "required": ["name", "url"]
    }
  }
}
